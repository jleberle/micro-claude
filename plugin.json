{
	"version": "1.3.0",
	"title": "Micro Claude Theme",
	"description": "A clean Solarized Light theme for micro.blog.",
	"fields": [
		{
			"field": "params.archive_months_photos",
			"label": "Show photo thumbnails in the archive",
			"type": "boolean"
		},
		{
			"field": "params.home_cat_started_reading",
			"label": "Homepage: category for Currently Reading",
			"placeholder": "Started Reading",
			"type": "string"
		},
		{
			"field": "params.home_cat_finished_reading",
			"label": "Homepage: category for Finished Reading",
			"placeholder": "Finished Reading",
			"type": "string"
		},
		{
			"field": "params.home_books_count",
			"label": "Homepage: number of Finished Reading books to show",
			"placeholder": "5",
			"type": "string"
		},
		{
			"field": "params.home_movies_count",
			"label": "Homepage: number of Movies to show",
			"placeholder": "6",
			"type": "string"
		},
		{
			"field": "params.home_highlights_count",
			"label": "Homepage: number of Highlights to show",
			"placeholder": "10",
			"type": "string"
		},
		{
			"field": "params.social_website_url",
			"label": "Personal website URL",
			"placeholder": "https://jaredeberle.org",
			"type": "string"
		},
		{
			"field": "params.social_bluesky_url",
			"label": "Bluesky URL",
			"placeholder": "https://bsky.app/profile/jaredeberle.org",
			"type": "string"
		},
		{
			"field": "params.social_letterboxd_url",
			"label": "Letterboxd URL",
			"placeholder": "https://letterboxd.com/eberle/",
			"type": "string"
		},
		{
			"field": "params.social_librarything_url",
			"label": "LibraryThing URL",
			"placeholder": "https://www.librarything.com/profile/jaredeberle",
			"type": "string"
		},
		{
			"field": "params.social_discogs_url",
			"label": "Discogs URL",
			"placeholder": "https://www.discogs.com/user/IrateBeagle",
			"type": "string"
		}
	]
}
